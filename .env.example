# ==============================================================================
# ARCHESS - Environment Configuration Template
# Copy this file to '.env' in production and update with your production secrets.
# ==============================================================================

# Core Application Settings
FLASK_ENV=production
PRODUCTION=1
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=0

# Security Secrets (CRITICAL: Generate a strong 64-char hex key using `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=replace_with_a_secure_cryptographic_random_hex_key

# Cookie Security (set to 1 for HTTPS deployments)
SESSION_COOKIE_SECURE=1

# Database Configuration
# Path to SQLite database file. Useful when mounting cloud volumes or docker volumes.
ARCHESS_DB_PATH=/app/data/archess.db

# Production WSGI Worker Threads (Gunicorn gthread pool)
WSGI_THREADS=16

# Cross-Origin Resource Sharing (CORS)
# Leave unset or '*' for public access, or comma-separate allowed production domains:
# CORS_ORIGINS=https://yourdomain.com,https://play.yourdomain.com
CORS_ORIGINS=*

# Third-Party Authentication (Google OAuth 2.0 / Google Identity Services)
# Configure these from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Administrator Auto-Provisioning & RBAC
# On boot, ARCHESS will auto-create or promote this account to Administrator
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_on_launch

# Seed Demo Users
# Set to 1 only in local offline demo environments. Keep 0 for production launch.
SEED_DEMO_DATA=0

# Logging & Monitoring
LOG_LEVEL=INFO

# Distributed State Synchronization (Redis Pub/Sub - Optional)
# When set, enables multi-container/cluster state sync; falls back to in-memory if unset.
REDIS_URL=redis://localhost:6379/0

# AI & LLM Configuration (100% Free & Open-Source)
# Built-in deterministic reasoning operates offline with zero configuration or cost.
# Optional: Connect to local Ollama or OpenAI-compatible endpoint
# AI_PROVIDER_URL=http://localhost:11434/v1/chat/completions
# AI_MODEL_NAME=llama3.2:1b
# Optional: Google Gemini Free Tier
# GEMINI_API_KEY=your-gemini-free-api-key

