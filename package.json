{
  "name": "physics-chess-variant",
  "version": "1.0.0",
  "description": "A physics-based chess variant where pieces are launched as projectiles to destroy the enemy king",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "nodemon src/server/index.js",
    "test": "jest",
    "build": "echo \"No build step required\"",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "client-install": "npm install --prefix client",
    "client-start": "npm start --prefix client",
    "client-dev": "npm run dev --prefix client",
    "client-build": "npm run build --prefix client",
    "client-test": "npm test --prefix client"
  },
  "keywords": [
    "physics",
    "chess",
    "game",
    "multiplayer",
    "socket.io"
  ],
  "author": "ArChess Developer",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "cannon-es": "^0.20.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "uuid": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "validator": "^13.11.0",
    "rate-limiter-flexible": "^2.4.1",
    "socket.io-redis": "^6.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.2.4",
    "jest-extended": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}